# Vercel Blob — copy from your Vercel dashboard after creating a Blob store
# Dashboard > Storage > Create Database > Blob > Connect to project
BLOB_READ_WRITE_TOKEN=

# Secret admin path — change this to something hard to guess, no slashes
# Your admin URL will be: https://your-domain.vercel.app/<ADMIN_PATH>
ADMIN_PATH=your-secret-path-here
