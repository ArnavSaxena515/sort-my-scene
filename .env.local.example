# Vercel KV — copy these from your Vercel dashboard after creating a KV store
# Dashboard > Storage > Create Database > KV > Connect to project
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Secret admin path — change this to something hard to guess, no slashes
# Your admin URL will be: https://your-domain.vercel.app/<ADMIN_PATH>
ADMIN_PATH=your-secret-path-here
